#!/bin/sh
set -eu
cd "$(dirname "$0")"
if command -v mvn >/dev/null 2>&1; then
    exec mvn "$@"
fi
VER=3.9.11
DEST=".mvn/apache-maven-$VER"
if [ ! -x "$DEST/bin/mvn" ]; then
    mkdir -p .mvn
    URL="https://repo.maven.apache.org/maven2/org/apache/maven/apache-maven/$VER/apache-maven-$VER-bin.tar.gz"
    if command -v curl >/dev/null 2>&1; then curl -fLsS "$URL" | tar -xz -C .mvn
    elif command -v wget >/dev/null 2>&1; then wget -qO- "$URL" | tar -xz -C .mvn
    else echo 'Instale o Maven ou curl/wget para continuar.' >&2; exit 1; fi
fi
exec "$DEST/bin/mvn" "$@"
